# Wallet qui recoit les creator fees et paie les gagnants.
# Wallet DEDIE, jamais le principal. Le token doit etre LANCE DEPUIS CE
# WALLET : sur Pons V2 l'escrow paie le creatorFeeRecipient du launch.
PRIVATE_KEY=0x...

# Le token, une fois lance sur Pons
TOKEN_ADDRESS=0x...
DEPLOY_BLOCK=

# Reseau — Robinhood Chain mainnet (chain id 4663)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Pons V2, lu sur la chaine (sonde du 2026-09-22). Deja par defaut dans
# chain.js, a surcharger seulement si Pons migre.
# PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e

# Pairing asset du launch = devise du pot.
#   ETH natif  : laisser vide
#   USDG       : FEE_ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168  FEE_DECIMALS=6
# Le bot verifie au demarrage que ca colle avec la factory et refuse de
# reclamer sinon.
FEE_ASSET=
FEE_DECIMALS=18

# Contrats supplementaires a exclure du tirage (la curve, le pool, le locker
# et l'escrow Pons sont deja exclus automatiquement).
EXCLUDED=

# Part du pot vs part createur, en %
POT_SHARE=70

# Seuil de declenchement, dans l'actif de paiement (0.02 ETH, ou 50 en USDG)
THRESHOLD=0.02

# Reserve de gas (ETH) a ne jamais envoyer au gagnant. Ignoree si le pot
# est un ERC20.
GAS_RESERVE=0.003

# Blocs entre l'annonce et le tirage. Mesure : 0,101 s/bloc sur Robinhood
# Chain, donc 1800 blocs ≈ 3 minutes de fenetre pour constater l'annonce.
DRAW_DELAY_BLOCKS=1800

TICK_SECONDS=30
PORT=3000
